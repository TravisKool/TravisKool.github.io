---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';
import { employers, education, certifications } from '../data/site';
---

<Base
  title="Work"
  description="Fifteen years of engineering — eight scaling high-stakes fintech infrastructure, four leading the teams that built it."
>
  <section class="page-head grid-backdrop">
    <div class="container">
      <p class="label label--accent">Work</p>
      <h1 class="page-head__title">Where I have been, and what changed while I was there.</h1>
      <p class="page-head__sub measure-wide">
        Fifteen years writing software. Eight of them scaling high-stakes
        fintech infrastructure, and the last four responsible for the
        architecture and the people building against it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionRule index="01" label="Experience" />

      <ol class="timeline">
        {
          employers.map((employer, i) => (
            <li class="employer" data-reveal data-reveal-delay={i * 50}>
              <div class="employer__aside">
                <div class="employer__period">
                  <span class="employer__dates">
                    {employer.start} — {employer.end ?? 'Present'}
                  </span>
                  {!employer.end && <span class="employer__now" aria-label="Current" />}
                </div>
                {employer.location && (
                  <p class="employer__location">{employer.location}</p>
                )}
              </div>

              <div class="employer__body">
                <h3 class="employer__name">{employer.company}</h3>
                {employer.summary && <p class="employer__summary">{employer.summary}</p>}

                <ol class="positions">
                  {employer.positions.map((position) => (
                    <li class="position">
                      <div class="position__head">
                        <h4 class="position__title">{position.title}</h4>
                        <p class="position__meta">
                          {position.start} — {position.end ?? 'Present'}
                          {position.arrangement && ` · ${position.arrangement}`}
                        </p>
                      </div>

                      <ul class="position__highlights">
                        {position.highlights.map((highlight) => (
                          <li>
                            {highlight.label && (
                              <span class="position__label">{highlight.label}</span>
                            )}
                            {highlight.body}
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ol>

                <ul class="employer__stack" aria-label="Technologies">
                  {employer.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionRule index="02" label="Education" />
      <div class="education">
        <h3 class="education__school">{education.school}</h3>
        <p class="education__meta">{education.years} · {education.degree}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionRule index="03" label="Certifications" />
      <ul class="certs">
        {
          certifications.map((cert, i) => (
            <li class="cert" data-reveal data-reveal-delay={i * 50}>
              <span class="cert__name">{cert.name}</span>
              <span class="cert__line" aria-hidden="true" />
              <span class="cert__meta">
                {cert.issuer}
                {cert.year && ` · ${cert.year}`}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-12);
  }

  .page-head__title {
    max-inline-size: 22ch;
    font-size: var(--text-3xl);
    font-weight: 400;
    margin-block: var(--space-6);
  }

  .page-head__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--ink-muted);
  }

  /* ---- Timeline ------------------------------------------------------- */
  .timeline {
    list-style: none;
    padding: 0;
  }

  .employer {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-6) var(--space-8);
    padding-block: var(--space-16);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .employer:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .employer__aside {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .employer__period {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .employer__dates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Amber marker on the current position — the same signal colour as the
     footer status dot, so the meaning stays consistent sitewide. */
  .employer__now {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--signal);
  }

  .employer__location {
    margin-block-start: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }

  .employer__name {
    font-size: var(--text-2xl);
    margin-block-end: var(--space-4);
  }

  .employer__summary {
    max-inline-size: var(--measure);
    color: var(--ink-muted);
    line-height: var(--leading-normal);
    margin-block-end: var(--space-8);
  }

  /* ---- Positions within an employer ------------------------------------
     A left rule ties multiple roles together as one tenure with a
     progression, rather than three unrelated jobs. */
  .positions {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .position {
    position: relative;
    padding-inline-start: var(--space-6);
    border-inline-start: var(--hairline) solid var(--rule);
  }

  .position + .position {
    margin-block-start: var(--space-12);
  }

  /* A small square on the rule marks each role change. */
  .position::before {
    content: '';
    position: absolute;
    inset-inline-start: -3px;
    inset-block-start: 0.55em;
    inline-size: 5px;
    block-size: 5px;
    background: var(--accent);
  }

  .position__head {
    margin-block-end: var(--space-4);
  }

  .position__title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    margin-block-end: var(--space-2);
  }

  .position__meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .position__highlights {
    max-inline-size: var(--measure);
    padding-inline-start: 0;
    list-style: none;
  }

  .position__highlights li {
    color: var(--ink-muted);
    line-height: var(--leading-normal);
  }

  .position__highlights li + li {
    margin-block-start: var(--space-4);
  }

  /* Inline mono lead-in, so each highlight is scannable without bullets. */
  .position__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink);
    margin-block-end: var(--space-1);
  }

  .employer__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .employer__stack li {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    padding: 0.3em 0.6em;
  }

  /* ---- Education ------------------------------------------------------ */
  .education__school {
    font-size: var(--text-xl);
    margin-block-end: var(--space-3);
  }

  .education__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }

  /* ---- Certifications -------------------------------------------------
     Same leader-line treatment as the competition list on /flying, so the
     two "record" sections of the site read as siblings. */
  .certs {
    list-style: none;
    padding: 0;
  }

  .cert {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: var(--hairline) solid var(--rule);
  }

  .cert:first-child {
    border-block-start: var(--hairline) solid var(--rule);
  }

  .cert__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
  }

  .cert__line {
    flex: 1;
    block-size: var(--hairline);
    background: var(--rule);
  }

  .cert__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  @media (max-width: 52rem) {
    .employer {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-12);
    }

    .employer__aside {
      position: static;
    }

    .cert {
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .cert__line {
      display: none;
    }
  }
</style>
