---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';
import EntryRow from '../components/EntryRow.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import {
  site,
  principles,
  pilotTotals,
  milestones,
  currently,
  currentlyPhotos,
} from '../data/site';
import { getWriting, getFlying, featuredFirst } from '../lib/collections';
import { yearsSoFar, tenureYears, durationBetween } from '../lib/career';

const writing = featuredFirst(await getWriting()).slice(0, 4);
const flying = (await getFlying()).slice(0, 3);

/**
 * Computed from the dates in `milestones`, not hand-written — so they cannot
 * drift from the timeline on /work. Engineering keeps accruing; leadership and
 * fintech are closed ranges that ended when the sabbatical began.
 * The `title` gives the precise figure on hover.
 */
const heroStats = [
  {
    label: 'Engineering',
    value: `${yearsSoFar(milestones.careerStart)} yrs`,
    title: durationBetween(milestones.careerStart),
  },
  {
    label: 'Leading teams',
    value: `${tenureYears(milestones.leadershipStart, milestones.leadershipEnd)} yrs`,
    title: durationBetween(milestones.leadershipStart, milestones.leadershipEnd),
  },
  {
    label: 'Fintech',
    value: `${tenureYears(milestones.fintechStart, milestones.fintechEnd)} yrs`,
    title: durationBetween(milestones.fintechStart, milestones.fintechEnd),
  },
  { label: 'Currently', value: site.status },
];
---

<Base>
  <!-- ==================================================================
       HERO
       Grid backdrop, mono role label, oversized serif statement. The stats
       underneath do the work a paragraph of throat-clearing would.
       ================================================================== -->
  <section class="hero grid-backdrop">
    <div class="container">
      <p class="hero__eyebrow label label--accent">{site.role}</p>

      <h1 class="hero__statement">{site.tagline}</h1>

      <p class="hero__intro measure-wide">{site.intro}</p>

      <dl class="stats">
        {
          heroStats.map((stat) => (
            <div class="stats__item">
              <dt class="label">{stat.label}</dt>
              <dd class="stats__value" title={stat.title}>
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ==================================================================
       CURRENTLY
       The sabbatical. The most distinctive thing about Travis right now, and
       the section that ties the engineering and flying halves together — so
       it leads, ahead of the principles.
       ================================================================== -->
  <section class="section">
    <div class="container">
      <SectionRule index="01" label="Currently" />

      <div class="now" data-reveal>
        <div class="now__body">
          <h3 class="now__headline">{currently.headline}</h3>
          {currently.body.map((paragraph) => <p class="now__para">{paragraph}</p>)}
        </div>

        <dl class="now__facts">
          {
            currently.facts.map((fact) => (
              <div class="now__fact">
                <dt class="label">{fact.key}</dt>
                <dd class="now__value">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Two frames, one per half of the sabbatical: the flying and the
           being-there. Deliberately the only photographs on the homepage. -->
      <div class="now__photos">
        <PhotoGrid photos={currentlyPhotos} columns={2} crop="square" />
      </div>
    </div>
  </section>

  <!-- ==================================================================
       PRINCIPLES
       Straight from the GitHub bio. Four short statements of taste — the
       fastest way for a reader to decide whether they want to work with you.
       ================================================================== -->
  <section class="section">
    <div class="container">
      <SectionRule index="02" label="How I work" href="/about/" linkLabel="More about me" />
      <ul class="principles">
        {
          principles.map((principle, i) => (
            <li class="principle" data-reveal data-reveal-delay={i * 70}>
              <h3 class="principle__title">{principle.title}</h3>
              <p class="principle__body">{principle.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================================================================
       WRITING
       ================================================================== -->
  {
    writing.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionRule index="03" label="Writing" href="/writing/" />
          <div class="index">
            {writing.map((entry, i) => (
              <EntryRow
                href={`/writing/${entry.id}/`}
                index={i + 1}
                title={entry.data.title}
                description={entry.data.description}
                kicker={entry.data.kind}
                date={entry.data.pubDate}
                featured={entry.data.featured}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ==================================================================
       FLYING
       Always renders, even before any flight is written up — the competition
       record alone is worth surfacing on the homepage.
       ================================================================== -->
  <section class="section">
    <div class="container">
      <SectionRule index="04" label="Flying" href="/flying/" linkLabel="The logbook" />

      <div class="flying" data-reveal>
        <p class="flying__lead measure-wide">
          I fly cross-country and competition paragliding. It rewards the same
          habits software does — preparation, honest debriefs, and respect for
          the parts you do not control.
        </p>

        <dl class="stats">
          {
            pilotTotals.map((stat) => (
              <div class="stats__item">
                <dt class="label">{stat.label}</dt>
                <dd class="stats__value">
                  {stat.value}
                  {stat.unit && <span class="stats__unit">{stat.unit}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      {
        flying.length > 0 && (
          <div class="index index--spaced">
            {flying.map((entry, i) => (
              <EntryRow
                href={`/flying/${entry.id}/`}
                index={i + 1}
                title={entry.data.title}
                description={entry.data.description}
                kicker={entry.data.kind}
                date={entry.data.pubDate}
                facts={[
                  entry.data.site ?? '',
                  entry.data.distance ? `${entry.data.distance} km` : '',
                  entry.data.airtime ? `${entry.data.airtime.toFixed(1)} hrs` : '',
                ].filter(Boolean)}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ==================================================================
       ELSEWHERE
       No email and no contact form by design — anyone who reaches this page
       already has the LinkedIn profile.
       ================================================================== -->
  <section class="section">
    <div class="container">
      <SectionRule index="05" label="Elsewhere" />
      <div class="contact" data-reveal>
        <p class="contact__lead measure-wide">
          I am always up for a conversation about architecture, engineering
          leadership, agentic systems, or anything with wings.
        </p>
        <ul class="contact__links">
          {
            site.links.map((link) => (
              <li>
                <a href={link.href} rel="me noopener" target="_blank">
                  {link.label} <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---------------------------------------------------------- */
  .hero {
    padding-block: clamp(var(--space-16), 9vw, var(--space-32)) var(--section-gap);
  }

  .hero__eyebrow {
    margin-block-end: var(--space-8);
  }

  .hero__statement {
    max-inline-size: 18ch;
    font-size: var(--text-4xl);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-block-end: var(--space-8);
  }

  .hero__intro {
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--ink-muted);
  }

  /* ---- Stats --------------------------------------------------------- */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-12);
    margin-block-start: var(--space-16);
    padding-block-start: var(--space-6);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  /* Units sit smaller and quieter than the figure, the way they do on an
     instrument face. */
  .stats__unit {
    margin-inline-start: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  /* ---- Currently ------------------------------------------------------
     Two columns: the narrative, and a sticky mono readout beside it. */
  .now {
    display: grid;
    grid-template-columns: 1fr 14rem;
    gap: var(--space-16);
    align-items: start;
  }

  .now__headline {
    font-size: var(--text-2xl);
    margin-block-end: var(--space-6);
  }

  .now__para {
    max-inline-size: var(--measure);
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: var(--leading-prose);
  }

  .now__para + .now__para {
    margin-block-start: var(--space-4);
  }

  .now__facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-inline-start: var(--space-6);
    border-inline-start: var(--hairline) solid var(--rule);
  }

  .now__fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .now__value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .now__photos {
    margin-block-start: var(--space-12);
  }

  /* ---- Principles ---------------------------------------------------- */
  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-8) var(--space-6);
    list-style: none;
    padding: 0;
  }

  .principle {
    padding-block-start: var(--space-4);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .principle__title {
    font-size: var(--text-lg);
    margin-block-end: var(--space-3);
  }

  .principle__body {
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  /* ---- Flying -------------------------------------------------------- */
  .flying__lead {
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--ink-muted);
  }

  .index--spaced {
    margin-block-start: var(--space-12);
  }

  /* ---- Elsewhere ----------------------------------------------------- */
  .contact__lead {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-block-start: var(--space-8);
    list-style: none;
    padding: 0;
  }

  .contact__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding-block-end: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    border-block-end: var(--hairline) solid
      color-mix(in oklab, var(--accent) 40%, transparent);
    transition: border-color var(--duration) var(--ease);
  }

  .contact__links a:hover {
    border-color: var(--accent);
  }

  @media (max-width: 52rem) {
    .now {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .now__facts {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-6) var(--space-8);
      padding-inline-start: 0;
      padding-block-start: var(--space-6);
      border-inline-start: 0;
      border-block-start: var(--hairline) solid var(--rule);
    }
  }
</style>
