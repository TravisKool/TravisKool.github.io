---
import Base from '../../layouts/Base.astro';
import EntryRow from '../../components/EntryRow.astro';
import SectionRule from '../../components/SectionRule.astro';
import { getFlying } from '../../lib/collections';
import { competitions, flyingProfiles, pilotStats } from '../../data/site';

const entries = await getFlying();

// Aggregates across logged entries. These grow as posts are added; the
// headline stats above them come from the scoring sites.
const totalDistance = entries.reduce((sum, e) => sum + (e.data.distance ?? 0), 0);
const totalAirtime = entries.reduce((sum, e) => sum + (e.data.airtime ?? 0), 0);
const sites = new Set(entries.map((e) => e.data.site).filter(Boolean));
---

<Base
  title="Flying"
  description="Cross-country and competition paragliding — flights, sites, and what the air taught me."
>
  <section class="page-head grid-backdrop">
    <div class="container">
      <p class="label label--accent">Paragliding</p>
      <h1 class="page-head__title">Cross-country, under a wing.</h1>
      <p class="page-head__sub measure-wide">
        I fly cross-country and competition paragliding out of the Sierra and
        the Great Basin. It is the other discipline where preparation, honest
        debriefs, and respect for the things you cannot control decide how the
        day goes — which is most of why it appears on an engineer's site.
      </p>

      <dl class="stats">
        {
          pilotStats.map((stat) => (
            <div class="stats__item">
              <dt class="label">{stat.label}</dt>
              <dd class="stats__value">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="stats__note">
        Competition record via
        {
          flyingProfiles.map((profile, i) => (
            <>
              {i > 0 && ' · '}
              <a href={profile.href} rel="noopener" target="_blank">
                {profile.label}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionRule index="01" label="Competitions" />
      <ol class="comps">
        {
          competitions.map((comp, i) => (
            <li class="comp" data-reveal data-reveal-delay={i * 60}>
              <span class="comp__name">{comp.name}</span>
              <span class="comp__line" aria-hidden="true" />
              <span class="comp__date">{comp.date}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionRule index="02" label="Flight log" />
      {
        entries.length > 0 ? (
          <>
            <dl class="stats stats--compact">
              <div class="stats__item">
                <dt class="label">Logged here</dt>
                <dd class="stats__value">{totalDistance.toFixed(0)} km</dd>
              </div>
              <div class="stats__item">
                <dt class="label">Airtime</dt>
                <dd class="stats__value">{totalAirtime.toFixed(1)} hrs</dd>
              </div>
              <div class="stats__item">
                <dt class="label">Sites</dt>
                <dd class="stats__value">{sites.size}</dd>
              </div>
            </dl>

            <div class="index">
              {entries.map((entry, i) => (
                <EntryRow
                  href={`/flying/${entry.id}/`}
                  index={i + 1}
                  title={entry.data.title}
                  description={entry.data.description}
                  kicker={entry.data.wing}
                  date={entry.data.pubDate}
                  featured={entry.data.featured}
                  facts={[
                    entry.data.site ?? '',
                    entry.data.distance ? `${entry.data.distance} km` : '',
                    entry.data.airtime ? `${entry.data.airtime.toFixed(1)} hrs` : '',
                    entry.data.maxAltitude
                      ? `${entry.data.maxAltitude.toLocaleString()} ft`
                      : '',
                  ].filter(Boolean)}
                />
              ))}
            </div>
          </>
        ) : (
          <p class="empty">No flights written up yet.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-12);
  }

  .page-head__title {
    max-inline-size: 22ch;
    font-size: var(--text-3xl);
    font-weight: 400;
    margin-block: var(--space-6);
  }

  .page-head__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--ink-muted);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-12);
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .stats--compact {
    margin-block-start: 0;
    margin-block-end: var(--space-12);
    border-block-start: 0;
    padding-block-start: 0;
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .stats__note {
    margin-block-start: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }

  .stats__note a {
    color: var(--ink-muted);
    text-decoration: none;
    border-block-end: var(--hairline) solid var(--rule-strong);
  }

  .stats__note a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Competition list: name, leader line, date. Reads like a programme or an
     index page, which suits the editorial half of the design. */
  .comps {
    list-style: none;
    padding: 0;
  }

  .comp {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: var(--hairline) solid var(--rule);
  }

  .comp:first-child {
    border-block-start: var(--hairline) solid var(--rule);
  }

  .comp__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
  }

  .comp__line {
    flex: 1;
    block-size: var(--hairline);
    background: var(--rule);
  }

  .comp__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .empty {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }
</style>
