---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getFlying } from '../../lib/collections';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const entries = await getFlying();
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

// Only include facts this entry actually has — an empty readout cell looks
// like a bug, not a design choice.
const facts = [
  entry.data.route.length > 1 && {
    key: 'Route',
    value: entry.data.route.join(' → '),
  },
  entry.data.hours && { key: 'Time', value: `${entry.data.hours.toFixed(1)} hrs` },
  entry.data.conditions && { key: 'Conditions', value: entry.data.conditions },
].filter(Boolean) as { key: string; value: string }[];
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  kicker={entry.data.aircraft}
  facts={facts}
  backHref="/flying/"
  backLabel="All flights"
>
  <Content />
</Article>
