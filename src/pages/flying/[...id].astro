---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getFlying } from '../../lib/collections';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const entries = await getFlying();
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

// Only include facts this entry actually has — an empty readout cell looks
// like a bug, not a design choice.
const facts = [
  entry.data.site && { key: 'Site', value: entry.data.site },
  entry.data.wing && { key: 'Wing', value: entry.data.wing },
  entry.data.distance && { key: 'Distance', value: `${entry.data.distance} km` },
  entry.data.airtime && { key: 'Airtime', value: `${entry.data.airtime.toFixed(1)} hrs` },
  // Metres, matching the schema and vol.flights. This read `ft` against a value
  // the schema documents as metric, so the same number rendered as feet here
  // and as metres on the index.
  entry.data.maxAltitude && {
    key: 'Max alt',
    value: `${entry.data.maxAltitude.toLocaleString()} m`,
  },
  entry.data.conditions && { key: 'Conditions', value: entry.data.conditions },
].filter(Boolean) as { key: string; value: string }[];
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  kicker={entry.data.kind}
  facts={facts}
  backHref="/flying/"
  backLabel="The logbook"
>
  <Content />

  {
    entry.data.trackLog && (
      <p>
        <a href={entry.data.trackLog} rel="noopener" target="_blank">
          View the track log →
        </a>
      </p>
    )
  }
</Article>
