---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

// Mark the active section. Compare on the first path segment so that
// /writing/some-post still highlights "Writing".
const current = Astro.url.pathname;
const segment = (path: string) => path.split('/').filter(Boolean)[0] ?? '';
const activeSegment = segment(current);
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label={`${site.name} — home`}>
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__name">{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          site.nav.map((item) => {
            const isActive = segment(item.href) === activeSegment && activeSegment !== '';
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['nav__link', { 'is-active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-block-size: 4rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-end: auto;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  /* A small filled square rather than a logo. Reads as a status indicator,
     which fits the instrument language of the rest of the site. */
  .nav__mark {
    inline-size: 7px;
    block-size: 7px;
    background: var(--accent);
    transition: transform var(--duration) var(--ease);
  }

  .nav__brand:hover .nav__mark {
    transform: rotate(45deg);
  }

  .nav__brand:hover {
    color: var(--ink);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 2.2vw, var(--space-8));
    list-style: none;
    padding: 0;
  }

  .nav__link {
    position: relative;
    display: block;
    padding-block: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-muted);
    text-decoration: none;
  }

  /* Underline grows from the left rather than fading in — a small detail, but
     it makes hover feel mechanical and deliberate instead of soft. */
  .nav__link::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after,
    .nav__mark {
      transition: none;
    }
  }

  /* On narrow screens the name would crowd the links out. The mark alone still
     identifies the home link, and the links stay reachable. */
  @media (max-width: 30rem) {
    .nav__name {
      display: none;
    }

    .nav__inner {
      gap: var(--space-3);
    }
  }
</style>
