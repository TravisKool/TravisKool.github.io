---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <!-- The instrument readout. Mono, tabular, faintly ridiculous in the best
         way — it signals "engineer" before a single word is read. -->
    <div class="readout" role="status">
      <span class="readout__cell">
        <span class="readout__key">LOC</span>
        <span class="readout__val">{site.location ?? '—'}</span>
      </span>
      <span class="readout__cell">
        <span class="readout__key">LOCAL</span>
        <!-- Hydrated by the script below; the server-rendered em dash is the
             no-JS fallback. -->
        <span class="readout__val" data-clock data-tz={site.timezone}>—</span>
      </span>
      <span class="readout__cell">
        <span class="readout__key">STATUS</span>
        <span class="readout__val">
          {
            site.openToOpportunities ? (
              <>
                <span class="readout__dot" aria-hidden="true"></span>Open to conversations
              </>
            ) : (
              'Heads down'
            )
          }
        </span>
      </span>
    </div>

    <div class="footer__main">
      <p class="footer__sig">
        <span class="footer__name">{site.name}</span>
        <span class="footer__role">{site.role}</span>
      </p>

      <ul class="footer__links">
        {
          site.links.map((link) => (
            <li>
              <a href={link.href} rel="me noopener" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
        {
          site.email && (
            <li>
              <a href={`mailto:${site.email}`}>Email</a>
            </li>
          )
        }
        <li>
          <a href="/rss.xml">RSS</a>
        </li>
      </ul>
    </div>

    <p class="footer__fine label">
      © {year} {site.name} · Built with Astro · Set in Newsreader &amp; JetBrains Mono
    </p>
  </div>
</footer>

<script>
  /**
   * Live local clock for the footer readout.
   * Re-runs after every view transition because the DOM node is replaced.
   */
  function startClock() {
    const el = document.querySelector<HTMLElement>('[data-clock]');
    if (!el) return;

    const tz = el.dataset.tz || 'UTC';
    const fmt = new Intl.DateTimeFormat('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: tz,
    });

    const tick = () => {
      // If the configured timezone is invalid, fail quietly rather than
      // throwing on every frame.
      try {
        el.textContent = fmt.format(new Date());
      } catch {
        el.textContent = '—';
      }
    };

    tick();
    window.clearInterval((window as any).__clockTimer);
    (window as any).__clockTimer = window.setInterval(tick, 15_000);
  }

  startClock();
  document.addEventListener('astro:page-load', startClock);
</script>

<style>
  .footer {
    margin-block-start: var(--section-gap);
    border-block-start: var(--hairline) solid var(--rule);
    padding-block: var(--space-8) var(--space-12);
  }

  .readout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    padding-block-end: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }

  .readout__cell {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .readout__key {
    color: var(--ink-faint);
  }

  .readout__val {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-muted);
  }

  /* Slow, soft pulse. Fast blinking would read as an alarm, not availability. */
  .readout__dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: pulse 2.6s var(--ease) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .readout__dot {
      animation: none;
    }
  }

  .footer__main {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-8);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .footer__sig {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .footer__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  .footer__links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-muted);
    text-decoration: none;
    border-block-end: var(--hairline) solid var(--rule-strong);
    padding-block-end: 2px;
  }

  .footer__links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .footer__fine {
    padding-block-start: var(--space-6);
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }
</style>
